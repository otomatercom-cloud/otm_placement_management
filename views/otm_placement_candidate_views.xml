<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_placement_candidate_form" model="ir.ui.view">
        <field name="name">otm.placement.candidate.form</field>
        <field name="model">otm.placement.candidate</field>
        <field name="arch" type="xml">
            <form string="Placement Candidate">
                <header>
                    <button name="action_set_stage" type="object" string="Mark Reviewed"
                            class="btn-primary" context="{'target_stage': 'reviewed'}"
                            invisible="stage != 'new'"/>
                    <button name="action_set_stage" type="object" string="Mark Contacted"
                            class="btn-primary" context="{'target_stage': 'contacted'}"
                            invisible="stage != 'reviewed'"/>
                    <button name="action_set_stage" type="object" string="Schedule Interview"
                            class="btn-primary" context="{'target_stage': 'interview_scheduled'}"
                            invisible="stage != 'contacted'"/>
                    <button name="action_set_stage" type="object" string="Mark Interview Completed"
                            class="btn-primary" context="{'target_stage': 'interview_completed'}"
                            invisible="stage != 'interview_scheduled'"/>
                    <button name="action_set_stage" type="object" string="Move to Follow-up"
                            class="btn-primary" context="{'target_stage': 'follow_up'}"
                            invisible="stage != 'interview_completed'"/>
                    <button name="action_set_stage" type="object" string="Mark Placement"
                            class="btn-primary" context="{'target_stage': 'placement'}"
                            invisible="stage not in ('interview_completed', 'follow_up')"/>
                    <button name="action_set_stage" type="object" string="Not Interested"
                            class="btn-secondary" context="{'target_stage': 'not_interested'}"
                            invisible="stage in ('placement', 'not_interested', 'cancelled')"/>
                    <button name="action_set_stage" type="object" string="Cancel"
                            class="btn-secondary" context="{'target_stage': 'cancelled'}"
                            invisible="stage in ('placement', 'not_interested', 'cancelled')"/>
                    <field name="stage" widget="statusbar"
                           statusbar_visible="new,reviewed,contacted,interview_scheduled,interview_completed,follow_up,placement"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_mock_interviews" type="object"
                                class="oe_stat_button" icon="fa-video-camera">
                            <field name="mock_interview_count" widget="statinfo" string="Mock Interviews"/>
                        </button>
                        <button name="action_view_placement_records" type="object"
                                class="oe_stat_button" icon="fa-briefcase">
                            <field name="placement_record_count" widget="statinfo" string="Placements"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Alumni" bg_color="text-bg-info"
                            invisible="erp_check_status != 'old_student'"/>
                    <widget name="web_ribbon" title="Existing Student" bg_color="text-bg-success"
                            invisible="erp_check_status != 'current_student'"/>
                    <div class="oe_title">
                        <h1><field name="candidate_reference" readonly="1"/></h1>
                        <field name="name" placeholder="Candidate Name"/>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="program_id"/>
                            <field name="admission_year"/>
                            <field name="qualification_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employment" name="page_employment">
                            <group>
                                <field name="employment_status"/>
                                <field name="company_name"/>
                                <field name="designation"/>
                            </group>
                        </page>
                        <page string="Interview" name="page_interview">
                            <group>
                                <field name="interview_preference"/>
                            </group>
                            <field name="mock_interview_ids" context="{'default_candidate_id': id}">
                                <list>
                                    <field name="scheduled_start"/>
                                    <field name="mode"/>
                                    <field name="interviewer_id"/>
                                    <field name="status"/>
                                    <field name="result"/>
                                </list>
                            </field>
                        </page>
                        <page string="Support" name="page_support">
                            <group>
                                <field name="support_area_ids" widget="many2many_tags"/>
                                <field name="additional_support"/>
                            </group>
                        </page>
                        <page string="Placement" name="page_placement">
                            <field name="placement_record_ids" context="{'default_candidate_id': id}">
                                <list>
                                    <field name="company_name"/>
                                    <field name="designation"/>
                                    <field name="employment_type"/>
                                    <field name="joining_date"/>
                                    <field name="placement_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Old ERP / Student Check" name="page_old_erp_check">
                            <div class="d-flex align-items-center mb-3" style="gap: 12px;">
                                <button name="action_check_old_erp_status" type="object"
                                        string="Check Old ERP" class="btn-secondary"
                                        icon="fa-refresh"/>
                                <field name="erp_check_status" widget="badge"
                                       decoration-success="erp_check_status in ('current_student', 'old_student')"
                                       decoration-info="erp_check_status == 'lead_only'"
                                       decoration-muted="erp_check_status in ('not_checked', 'not_found')"
                                       decoration-warning="erp_check_status == 'unavailable'"
                                       readonly="1"/>
                            </div>
                            <group>
                                <field name="erp_check_note" readonly="1"/>
                                <field name="erp_checked_on" readonly="1"/>
                            </group>
                        </page>
                        <page string="Internal Notes" name="page_internal_notes">
                            <field name="registration_date" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_placement_candidate_list" model="ir.ui.view">
        <field name="name">otm.placement.candidate.list</field>
        <field name="model">otm.placement.candidate</field>
        <field name="arch" type="xml">
            <list decoration-muted="stage in ('cancelled', 'not_interested')">
                <field name="candidate_reference"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="qualification_status"/>
                <field name="employment_status"/>
                <field name="interview_preference"/>
                <field name="stage" widget="badge"
                       decoration-success="stage == 'placement'"
                       decoration-info="stage == 'interview_scheduled'"
                       decoration-warning="stage == 'follow_up'"/>
                <field name="erp_check_status" widget="badge" optional="show"
                       string="Old ERP"
                       decoration-success="erp_check_status in ('current_student', 'old_student')"
                       decoration-info="erp_check_status == 'lead_only'"
                       decoration-muted="erp_check_status in ('not_checked', 'not_found')"
                       decoration-warning="erp_check_status == 'unavailable'"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_otm_placement_candidate_kanban" model="ir.ui.view">
        <field name="name">otm.placement.candidate.kanban</field>
        <field name="model">otm.placement.candidate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" records_draggable="true">
                <field name="stage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="candidate_reference"/></div>
                            <div><field name="program_id"/></div>
                            <div class="text-muted">
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_otm_placement_candidate_search" model="ir.ui.view">
        <field name="name">otm.placement.candidate.search</field>
        <field name="model">otm.placement.candidate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Candidate" filter_domain="['|', ('name', 'ilike', self), ('candidate_reference', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_online" string="Online" domain="[('interview_preference', '=', 'online')]"/>
                <filter name="filter_offline" string="Offline" domain="[('interview_preference', '=', 'offline')]"/>
                <separator/>
                <filter name="filter_my" string="My Candidates" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <group>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                    <filter name="group_employment" string="Employment Status" context="{'group_by': 'employment_status'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_mode" string="Interview Mode" context="{'group_by': 'interview_preference'}"/>
                    <filter name="group_qualification" string="Qualification Status" context="{'group_by': 'qualification_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_placement_candidate_check_old_erp" model="ir.actions.server">
        <field name="name">Check Old ERP Status</field>
        <field name="model_id" ref="model_otm_placement_candidate"/>
        <field name="binding_model_id" ref="model_otm_placement_candidate"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_check_old_erp_status()</field>
    </record>

    <record id="action_otm_placement_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">otm.placement.candidate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_otm_placement_candidate_search"/>
        <field name="context">{'search_default_filter_my': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">No candidates yet. They will appear here once they register through the placement portal.</p>
        </field>
    </record>

</odoo>

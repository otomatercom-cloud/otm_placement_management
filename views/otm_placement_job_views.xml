<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Job Opening ===================== -->
    <record id="view_otm_placement_job_opening_form" model="ir.ui.view">
        <field name="name">otm.placement.job.opening.form</field>
        <field name="model">otm.placement.job.opening</field>
        <field name="arch" type="xml">
            <form string="Job Opening">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'published'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Accounts Executive"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_name"/>
                            <field name="location"/>
                            <field name="employment_type"/>
                            <field name="salary_range"/>
                        </group>
                        <group>
                            <field name="openings"/>
                            <field name="last_date"/>
                            <field name="program_ids" widget="many2many_tags"/>
                            <field name="apply_link" widget="url"/>
                            <field name="user_id"/>
                            <field name="published_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="page_description">
                            <field name="description" placeholder="What the role involves..."/>
                        </page>
                        <page string="Requirements" name="page_requirements">
                            <field name="requirements" placeholder="Skills, qualifications, experience..."/>
                        </page>
                        <page string="Applications" name="page_applications">
                            <field name="application_ids" context="{'default_job_id': id}">
                                <list>
                                    <field name="candidate_id"/>
                                    <field name="applied_date"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'shortlisted'"
                                           decoration-success="state == 'selected'"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_placement_job_opening_list" model="ir.ui.view">
        <field name="name">otm.placement.job.opening.list</field>
        <field name="model">otm.placement.job.opening</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="company_name"/>
                <field name="location"/>
                <field name="employment_type"/>
                <field name="openings"/>
                <field name="last_date"/>
                <field name="application_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_otm_placement_job_opening_search" model="ir.ui.view">
        <field name="name">otm.placement.job.opening.search</field>
        <field name="model">otm.placement.job.opening</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Job" filter_domain="['|', ('name', 'ilike', self), ('company_name', 'ilike', self)]"/>
                <field name="program_ids"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_name'}"/>
                    <filter name="group_type" string="Employment Type" context="{'group_by': 'employment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_placement_job_opening" model="ir.actions.act_window">
        <field name="name">Job Openings</field>
        <field name="res_model">otm.placement.job.opening</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_otm_placement_job_opening_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smile">Create your first job opening, then publish it. Only candidates approved for jobs will see it.</p>
        </field>
    </record>

    <!-- ===================== Job Application ===================== -->
    <record id="view_otm_placement_job_application_form" model="ir.ui.view">
        <field name="name">otm.placement.job.application.form</field>
        <field name="model">otm.placement.job.application</field>
        <field name="arch" type="xml">
            <form string="Job Application">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"
                           statusbar_visible="applied,shortlisted,selected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="candidate_id"/>
                        </group>
                        <group>
                            <field name="applied_date"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_placement_job_application_list" model="ir.ui.view">
        <field name="name">otm.placement.job.application.list</field>
        <field name="model">otm.placement.job.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="candidate_id"/>
                <field name="job_id"/>
                <field name="applied_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'shortlisted'"
                       decoration-success="state == 'selected'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_otm_placement_job_application_search" model="ir.ui.view">
        <field name="name">otm.placement.job.application.search</field>
        <field name="model">otm.placement.job.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="candidate_id"/>
                <field name="job_id"/>
                <separator/>
                <filter name="filter_applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <filter name="filter_shortlisted" string="Shortlisted" domain="[('state', '=', 'shortlisted')]"/>
                <filter name="filter_selected" string="Selected" domain="[('state', '=', 'selected')]"/>
                <group>
                    <filter name="group_job" string="Job Opening" context="{'group_by': 'job_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_placement_job_application" model="ir.actions.act_window">
        <field name="name">Job Applications</field>
        <field name="res_model">otm.placement.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_otm_placement_job_application_search"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_placement_record_form" model="ir.ui.view">
        <field name="name">otm.placement.record.form</field>
        <field name="model">otm.placement.record</field>
        <field name="arch" type="xml">
            <form string="Placement Record">
                <header>
                    <field name="placement_status" widget="statusbar"
                           statusbar_visible="not_placed,interviewing,selected,placed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="candidate_id"/>
                            <field name="company_name"/>
                            <field name="designation"/>
                        </group>
                        <group>
                            <field name="employment_type"/>
                            <field name="joining_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="salary"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_placement_record_list" model="ir.ui.view">
        <field name="name">otm.placement.record.list</field>
        <field name="model">otm.placement.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="candidate_id"/>
                <field name="company_name"/>
                <field name="designation"/>
                <field name="employment_type"/>
                <field name="joining_date"/>
                <field name="placement_status" widget="badge"
                       decoration-success="placement_status == 'placed'"/>
            </list>
        </field>
    </record>

    <record id="view_otm_placement_record_search" model="ir.ui.view">
        <field name="name">otm.placement.record.search</field>
        <field name="model">otm.placement.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="candidate_id"/>
                <field name="company_name"/>
                <group>
                    <filter name="group_status" string="Placement Status" context="{'group_by': 'placement_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_placement_record" model="ir.actions.act_window">
        <field name="name">Placement Records</field>
        <field name="res_model">otm.placement.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_otm_placement_record_search"/>
    </record>

</odoo>

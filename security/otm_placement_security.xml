<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="privilege_placement" model="res.groups.privilege">
            <field name="name">Placement</field>
            <field name="category_id" ref="base.module_category_customizations"/>
        </record>

        <record id="group_placement_user" model="res.groups">
            <field name="name">Placement User</field>
            <field name="privilege_id" ref="privilege_placement"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Read candidates, create/update assigned records, view interviews.
            </field>
        </record>

        <record id="group_placement_manager" model="res.groups">
            <field name="name">Placement Manager</field>
            <field name="privilege_id" ref="privilege_placement"/>
            <field name="implied_ids" eval="[(4, ref('group_placement_user'))]"/>
            <field name="comment">
                Full candidate management, interview scheduling, placement management.
            </field>
        </record>

        <record id="group_placement_administrator" model="res.groups">
            <field name="name">Placement Administrator</field>
            <field name="privilege_id" ref="privilege_placement"/>
            <field name="implied_ids" eval="[(4, ref('group_placement_manager'))]"/>
            <field name="comment">
                Configuration, security, full access.
            </field>
        </record>

        <!-- Placement User: full read on candidates, write/create limited to
             candidates assigned to them (or not yet assigned). -->
        <record id="rule_candidate_user_read" model="ir.rule">
            <field name="name">Placement User: read all candidates</field>
            <field name="model_id" ref="model_otm_placement_candidate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_placement_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_candidate_user_write" model="ir.rule">
            <field name="name">Placement User: manage assigned candidates</field>
            <field name="model_id" ref="model_otm_placement_candidate"/>
            <field name="domain_force">
                ['|', ('user_id', '=', user.id), ('user_id', '=', False)]
            </field>
            <field name="groups" eval="[(4, ref('group_placement_user'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>

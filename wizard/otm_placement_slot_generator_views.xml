<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_placement_slot_generator_form" model="ir.ui.view">
        <field name="name">otm.placement.slot.generator.form</field>
        <field name="model">otm.placement.slot.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Interview Slots">
                <group>
                    <field name="generation_mode" widget="radio"/>
                </group>
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"
                               help="Custom Time Slots mode: each time line below repeats weekly across this range."/>
                    </group>
                    <group string="Per-Day Schedule" invisible="generation_mode != 'uniform'">
                        <field name="day_start_time" widget="float_time"/>
                        <field name="slots_per_day"/>
                        <field name="slot_duration"/>
                        <field name="gap_minutes"/>
                    </group>
                    <group string="Slot Duration" invisible="generation_mode != 'custom'">
                        <field name="slot_duration"
                               help="Used only for a time line NOT marked 'One Slot For Whole Window'."/>
                        <field name="gap_minutes"/>
                    </group>
                </group>
                <group string="Weekdays" invisible="generation_mode != 'uniform'">
                    <div class="d-flex flex-wrap" style="gap: 16px;" colspan="2">
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_mon"/><label for="weekday_mon" string="Mon"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_tue"/><label for="weekday_tue" string="Tue"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_wed"/><label for="weekday_wed" string="Wed"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_thu"/><label for="weekday_thu" string="Thu"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_fri"/><label for="weekday_fri" string="Fri"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_sat"/><label for="weekday_sat" string="Sat"/>
                        </div>
                        <div class="d-flex align-items-center" style="gap: 4px;">
                            <field name="weekday_sun"/><label for="weekday_sun" string="Sun"/>
                        </div>
                    </div>
                </group>
                <group string="Custom Time Slots" invisible="generation_mode != 'custom'">
                    <field name="time_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="weekday"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="single_slot"/>
                            <field name="interviewer_id" optional="show"/>
                            <field name="external_interviewer_name" optional="show"/>
                            <field name="external_interviewer_contact" optional="hide"/>
                        </list>
                    </field>
                </group>
                <group>
                    <group string="Slot Details">
                        <field name="mode"/>
                        <field name="capacity"/>
                        <field name="interviewer_id"
                               string="Default Interviewer"/>
                        <field name="external_interviewer_name"
                               string="Default External Interviewer"/>
                        <field name="external_interviewer_contact"
                               invisible="not external_interviewer_name"/>
                    </group>
                    <group string="Location" invisible="mode != 'online'">
                        <field name="meeting_platform"/>
                        <field name="meeting_url"/>
                    </group>
                    <group string="Location" invisible="mode != 'offline'">
                        <field name="venue"/>
                    </group>
                </group>
                <div class="alert alert-info mt-2" role="alert" invisible="not preview">
                    <field name="preview" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_generate_slots" type="object"
                            string="Generate Slots" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_otm_placement_slot_generator" model="ir.actions.act_window">
        <field name="name">Generate Interview Slots</field>
        <field name="res_model">otm.placement.slot.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
